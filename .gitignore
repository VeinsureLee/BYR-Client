# Only reviewed source files and required build inputs belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/go.mod
!/go.sum
!/main.go
!/mygo.json

!/internal/
/internal/**
!/internal/**/
!/internal/**/*.go

!/resources/
/resources/*
!/resources/icon.png

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/release.yml

# Local AI tooling, editor state, plans, screenshots, and build output.
.claude/
.codex/
.agents/
.cursor/
.gstack/
.idea/
.vscode/
AGENTS.md
CLAUDE.md
GEMINI.md
SKILL.md
/docs/
/screenshots/
/dist/
/tmp*/
tmp-*
*.local.*
*.exe
*.dll
*.syso
*.test
*.log

# Private runtime settings, accounts, cookies, keys, and local databases.
.env
.env.*
.byr-client/
settings.json
session.json
credentials.json
ai-key.txt
ai-keys.json
*.pem
*.key
*.p12
*.pfx
*.db
*.db-*
*.sqlite
*.sqlite3
